<%= render "shared/second-header" %>

<div class="item-show">
  <div class="item-box">
    <h2 class="name">
      <%= @item.name %>
    </h2>

    <div class="item-img-content">
      <%# 商品画像 %>
      <%= image_tag @item.image, class: "item-box-img" if @item.image.attached? %>

      <%# 売却済み商品の場合に「sold out」を表示（後で有効化予定） %>
      <%# if @item.purchase_management.present? %>
        <%# <div class="sold-out"><span>Sold Out!!</span></div> %>
      <%# end %>
    </div>

    <div class="item-price-box">
      <span class="item-price">¥ <%= number_with_delimiter(@item.price, delimiter: ',') %></span>
      <span class="item-postage"><%= @item.shipping_fee.name %></span>
    </div>

    <%# -------------------------------
         ボタンの表示条件分岐
         ------------------------------- %>

<% if user_signed_in? %>
  <% if current_user == @item.user %>
    <%# 自分の出品中商品 → 編集・削除ボタン %>
<%= link_to "商品の編集", "#", class: "item-red-btn" %>
<p class="or-text">or</p>
<%= link_to "削除", "#", class: "item-destroy" %>
  <% else %>
    <%= link_to "購入画面に進む", "#", class:"item-red-btn" %>
  <% end %>
<% end %>

    <div class="item-explain-box">
      <span><%= @item.description %></span>
    </div>

    <table class="detail-table">
      <tbody>
        <tr>
          <th class="detail-item">出品者</th>
          <td class="detail-value"><%= @item.user.nickname %></td>
        </tr>
        <tr>
          <th class="detail-item">カテゴリー</th>
          <td class="detail-value"><%= @item.category.name %></td>
        </tr>
        <tr>
          <th class="detail-item">商品の状態</th>
          <td class="detail-value"><%= @item.condition.name %></td>
        </tr>
        <tr>
          <th class="detail-item">配送料の負担</th>
          <td class="detail-value"><%= @item.shipping_fee.name %></td>
        </tr>
        <tr>
          <th class="detail-item">発送元の地域</th>
          <td class="detail-value"><%= @item.prefecture.name %></td>
        </tr>
        <tr>
          <th class="detail-item">発送日の目安</th>
          <td class="detail-value"><%= @item.shipping_day.name %></td>
        </tr>
      </tbody>
    </table>

    <div class="option">
      <div class="favorite-btn">
        <%= image_tag "star.png", class: "favorite-star-icon", width: "20", height: "20" %>
        <span>お気に入り 0</span>
      </div>
      <div class="report-btn">
        <%= image_tag "flag.png", class: "report-flag-icon", width: "20", height: "20" %>
        <span>不適切な商品の通報</span>
      </div>
    </div>
  </div>

  <%# コメント欄 %>
  <div class="comment-box">
    <form>
      <textarea class="comment-text"></textarea>
      <p class="comment-warn">
        相手のことを考え丁寧なコメントを心がけましょう。
        <br>
        不快な言葉遣いなどは利用制限や退会処分となることがあります。
      </p>
      <button type="submit" class="comment-btn">
        <%= image_tag "comment.png", class: "comment-flag-icon", width: "20", height: "25" %>
        <span>コメントする</span>
      </button>
    </form>
  </div>

  <div class="links">
    <%= link_to "＜ 前の商品", "#", class: "change-item-btn" %>
    <%= link_to "後ろの商品 ＞", "#", class: "change-item-btn" %>
  </div>

  <%# カテゴリーリンク %>
  <%= link_to "#{@item.category.name}をもっと見る", "#", class: "another-item" %>
</div>

<%= render "shared/footer" %>